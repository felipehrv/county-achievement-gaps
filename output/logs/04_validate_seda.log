. local n_fits 0

. local n_fail 0

. foreach s in $STATES {
  2.     local sn = real("`s'")
  3.     foreach g in $GRADES {
  4.         forvalues sub = 1/3 {
  5.             preserve
  6.                 quietly keep if fips == `sn' & grade == `g' & subgroup == `sub'
  7.                 quietly count
  8.                 local ng = r(N)
  9.                 if `ng' < 3 {
 10.                     restore
 11.                     continue
 12.                 }
 13.                 sort county_fips
 14.                 gen int gid = _n
 15.                 local ++n_fits
 16.                 capture quietly hetop gid n_cat, numcats(4) identify(sums)
 17.                 local rc = _rc
 18.                 local ok = (`rc' == 0)
 19.                 if `ok' local ok = (e(converged) == 1)
 20.                 if `ok' {
 21.                     matrix _M   = e(mstar)
 22.                     matrix _Mse = e(mstar_se)
 23.                     matrix _S   = e(sstar)
 24.                     forvalues i = 1/`=_N' {
 25.                         post `pf' (`sn') (`g') (`sub') (county_fips[`i']) ///
>                             (_M[`i', 1]) (_Mse[`i', 1]) (_S[`i', 1]) (1)
 26.                     }
 27.                 }
 28.                 else {
 29.                     local ++n_fail
 30.                     forvalues i = 1/`=_N' {
 31.                         post `pf' (`sn') (`g') (`sub') (county_fips[`i']) (.) (.) (.) (0)
 32.                     }
 33.                 }
 34.             restore
 35.             display as text "  state `s', grade `g', subgroup `sub': " ///
>                 cond(`ok', "converged", "FAILED (rc `rc')") " with `ng' counties"
 36.         }
 37.     }
 38. }
