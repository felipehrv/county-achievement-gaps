. quietly levelsof fips, local(stlist)

. foreach s of local stlist {
  2.     local sname : label stfips `s'
  3.     foreach g in $GRADES {
  4.         quietly count if !missing(mu_all) & !missing(seda_cs_mn_all) & fips == `s' & grade == `g'
  5.         local n1 = r(N)
  6.         local r1 = .
  7.         if `n1' >= 5 {
  8.             quietly correlate mu_all seda_cs_mn_all if fips == `s' & grade == `g'
  9.             local r1 = r(rho)
 10.         }
 11.         quietly count if !missing(gap_wb) & !missing(seda_cs_mn_wbg) & fips == `s' & grade == `g'
 12.         local n2 = r(N)
 13.         local r2 = .
 14.         if `n2' >= 5 {
 15.             quietly correlate gap_wb seda_cs_mn_wbg if fips == `s' & grade == `g'
 16.             local r2 = r(rho)
 17.         }
 18.         file write `fg' "`s',`sname',`g',`n1',`r1',`n2',`r2'" _n
 19.     }
 20. }

