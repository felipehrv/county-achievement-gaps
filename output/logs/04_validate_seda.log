. * Both measures are standardized within state and grade before pooling grades
. * within a state, so that the grade-specific constants of the SEDA scale do
. * not enter the comparison.
. foreach pair in "mu_all seda_cs_mn_all" "mu_white seda_cs_mn_wht" "mu_black seda_cs_mn_blk" ///
>                 "gap_wb seda_cs_mn_wbg" {
  2.     local ours : word 1 of `pair'
  3.     local theirs : word 2 of `pair'
  4.     foreach v in `ours' `theirs' {
  5.         quietly bysort fips grade: egen double _m = mean(`v') if !missing(`ours') & !missing(`theirs')
  6.         quietly bysort fips grade: egen double _s = sd(`v')   if !missing(`ours') & !missing(`theirs')
  7.         gen double z_`v' = (`v' - _m) / _s
  8.         drop _m _s
  9.     }
 10. }
