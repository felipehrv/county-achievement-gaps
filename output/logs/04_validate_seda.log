. foreach m of local measures {
  2.     local x : word 1 of `v_`m''
  3.     local y : word 2 of `v_`m''
  4.     quietly levelsof fips, local(stlist)
  5.     foreach s of local stlist {
  6.         quietly count if !missing(`x') & !missing(`y') & fips == `s'
  7.         local n = r(N)
  8.         if `n' < 5 continue
  9.         quietly correlate `x' `y' if fips == `s'
 10.         local rp = r(rho)
 11.         quietly spearman `x' `y' if fips == `s'
 12.         local rs = r(rho)
 13.         local sname : label stfips `s'
 14.         display as text %-12s "`m'" %-18s "`sname'" %8.0f `n' %10.3f `rp' %10.3f `rs'
 15.         file write `fh' "`m',`s',`sname',`n',`rp',`rs'" _n
 16.     }
 17.     quietly count if !missing(`x') & !missing(`y')
 18.     local n = r(N)
 19.     if `n' >= 5 {
 20.         quietly correlate `x' `y'
 21.         local rp = r(rho)
 22.         quietly spearman `x' `y'
 23.         local rs = r(rho)
 24.         display as result %-12s "`m'" %-18s "All states" %8.0f `n' %10.3f `rp' %10.3f `rs'
 25.         file write `fh' "`m',0,All states,`n',`rp',`rs'" _n
 26.     }
 27. }
