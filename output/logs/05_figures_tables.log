. 
. * html_table writes the data in memory as an HTML table fragment: variable
. * labels as headers, display formats for numbers, value labels where defined.
. capture program drop html_table

. program define html_table
  1.     syntax using/, [Title(string)]
  2.     tempname fh
  3.     file open `fh' using `"`using'"', write replace text
  4.     if `"`title'"' != "" file write `fh' `"<p class="tbl-title">`title'</p>"' _n
  5.     file write `fh' `"<table class="dt">"' _n "<thead><tr>"
  6.     foreach v of varlist _all {
  7.         local lab : variable label `v'
  8.         if `"`lab'"' == "" local lab "`v'"
  9.         file write `fh' `"<th>`lab'</th>"'
 10.     }
 11.     file write `fh' "</tr></thead>" _n "<tbody>" _n
 12.     forvalues i = 1/`=_N' {
 13.         file write `fh' "<tr>"
 14.         foreach v of varlist _all {
 15.             capture confirm string variable `v'
 16.             if !_rc {
 17.                 local val = `v'[`i']
 18.             }
 19.             else {
 20.                 local vl : value label `v'
 21.                 if "`vl'" != "" {
 22.                     local val : label `vl' `=`v'[`i']'
 23.                 }
 24.                 else {
 25.                     local fmt : format `v'
 26.                     local val : display `fmt' `v'[`i']
 27.                     local val = trim("`val'")
 28.                 }
 29.             }
 30.             file write `fh' "<td>`val'</td>"
 31.         }
 32.         file write `fh' "</tr>" _n
 33.     }
 34.     file write `fh' "</tbody></table>" _n
 35.     file close `fh'
 36. end

