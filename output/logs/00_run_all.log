. 
. *==============================================================================
. * PIPELINE
. *==============================================================================
. timer clear 99

. timer on 99

. 
. local scripts 01_download 02_build_master 03_estimate_gaps 04_validate_seda 05_figures_tables

. 
. foreach s of local scripts {
  2.     local n = substr("`s'", 1, 2)
  3.     if strpos(" ${RUN_STEPS} ", " `n' ") == 0 continue
  4. 
.     * The SEDA file may be downloaded only after the data use agreement has
.     * been read and accepted (global SEDA_ACCEPT_DUA above).
.     if "`n'" == "04" & ${SEDA_ACCEPT_DUA} != 1 {
  5.         display as error _n "Step 04 needs the SEDA county file. Read the SEDA data use agreement at"
  6.         display as error "https://edopportunity.org/opportunity/data/ and set SEDA_ACCEPT_DUA to 1 in"
  7.         display as error `"run_all.do; then run again with RUN_STEPS set to "04 05 docs"."'
  8.         log close master
  9.         exit 1
 10.     }
 11. 
.     display as result _n "{hline 78}"
 12.     display as result " Running `s'.do"
 13.     display as result "{hline 78}"
 14.     timer clear `=real("`n'")'
 15.     timer on `=real("`n'")'
 16.     do "${code}/`s'.do"
 17.     timer off `=real("`n'")'
 18.     quietly timer list `=real("`n'")'
 19.     record_runtime "`s'" `=r(t`=real("`n'")')'
 20.     display as result " `s'.do finished in " %8.1f r(t`=real("`n'")') " seconds"
 21. }

