. gen long n_cat3 = round(n_tested * p_cat3)

. gen long n_cat4 = n_tested - n_cat1 - n_cat2 - n_cat3

. drop _mu_imp p_cat*

. assert n_cat1 >= 0 & n_cat2 >= 0 & n_cat3 >= 0 & n_cat4 >= 0

