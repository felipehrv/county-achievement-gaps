. display as text _n "Fitting HETOP to `n_cells' county-grade cells..."

Fitting HETOP to 1065 county-grade cells...

. timer clear 31

. timer on 31

. 
. local i = 0

. local n_failed = 0

. local n_incomplete = 0

. 
. foreach c of local cells {
  2.     local ++i
  3. 
.     preserve
  4.         quietly keep if cell_id == `c'
  5.         quietly count
  6.         local nrows = r(N)
  7.         local cfips = county_fips[1]
  8.         local gg    = grade[1]
  9.         local yy    = year[1]
 10. 
.         * A cell without all three subgroups cannot be fit with the common
.         * design; it is written out with missing estimates so that the count
.         * of incomplete cells is visible downstream.
.         if `nrows' != 3 {
 11.             forvalues s = 1/3 {
 12.                 post `pf' (`c') (`cfips') (`gg') (`yy') (`s') (.) (.) ///
>                     (.) (.) (.) (.) (.) (.) (.) (.) (0)
 13.             }
 14.             restore
 15.             local ++n_incomplete
 16.             continue
 17.         }
 18. 
.         capture quietly hetop subgroup n_cat, numcats(4) identify(sums) gaps minsize(20)
 19.         local rc = _rc
 20.         local ok = (`rc' == 0)
 21.         if `ok' local ok = (e(converged) == 1)
 22.         * A fit that returns fewer than three groups (hetop drops groups below
.         * its minsize) is treated as a failure rather than read out of order
.         if `ok' local ok = (rowsof(e(mstar)) == 3)
 23. 
.         if `ok' {
 24.             matrix _Mstar = e(mstar)
 25.             matrix _Sstar = e(sstar)
 26.             matrix _MseS  = e(mstar_se)
 27.             matrix _SseS  = e(sstar_se)
 28.             matrix _Mraw  = e(mraw)
 29.             matrix _Sraw  = e(sraw)
 30.             matrix _MseR  = e(mraw_se)
 31.             matrix _SseR  = e(sraw_se)
 32. 
.             * hetop orders groups by the numeric value of subgroup (1, 2, 3)
.             forvalues s = 1/3 {
 33.                 local ns = n_tested[`s']
 34.                 local pp = pct_proficient[`s']
 35.                 post `pf' (`c') (`cfips') (`gg') (`yy') (`s') (`ns') (`pp') ///
>                     (_Mraw[`s', 1])  (_Sraw[`s', 1])  ///
>                     (_MseR[`s', 1])  (_SseR[`s', 1])  ///
>                     (_Mstar[`s', 1]) (_Sstar[`s', 1]) ///
>                     (_MseS[`s', 1])  (_SseS[`s', 1])  ///
>                     (1)
 36.             }
 37.         }
 38.         else {
 39.             forvalues s = 1/3 {
 40.                 local ns = n_tested[`s']
 41.                 local pp = pct_proficient[`s']
 42.                 post `pf' (`c') (`cfips') (`gg') (`yy') (`s') (`ns') (`pp') ///
>                     (.) (.) (.) (.) (.) (.) (.) (.) (0)
 43.             }
 44.             local ++n_failed
 45.         }
 46.     restore
 47. 
.     if mod(`i', `step') == 0 {
 48.         display as text "  processed " %5.0f `i' " / `n_cells' (" %3.0f 100 * `i' / `n_cells' "%)"
 49.     }
 50. }
