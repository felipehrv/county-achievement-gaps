. *------------------------------------------------------------------------------
. * 1C. CCD enrollment by race (all grades, grade code 99)
. *------------------------------------------------------------------------------
. timer clear 13

. timer on 13

. 
. capture confirm file "${raw}/ccd_enrollment_race.dta"

. if _rc | `reuse' != 1 {
.     tempfile acc
.     local first 1
.     foreach st in $STATES {
  2.         display as text _n "  CCD enrollment by race: state FIPS `st'"
  3.         fetch_or_stop "district ccd enrollment race" "year=${EDF_YEAR} fips=`st' grade=99"
  4.         local keepvars leaid year fips race enrollment
  5.         capture confirm variable leaid_num
  6.         if !_rc local keepvars `keepvars' leaid_num
  7.         quietly keep `keepvars'
  8.         if `first' {
  9.             quietly save `acc', replace
 10.             local first 0
 11.         }
 12.         else {
 13.             append using `acc'
 14.             quietly save `acc', replace
 15.         }
 16.     }

