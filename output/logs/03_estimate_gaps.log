. forvalues k = 1/4 {
  2.     quietly estimates restore m`k'
  3.     foreach v in poverty_rate district_fragmentation share_black seg_bw_index {
  4.         capture local b = _b[`v']
  5.         if _rc continue
  6.         file write `fh' "`k',`v',`=_b[`v']',`=_se[`v']',`=e(r2_a)',`=e(r2)',`=e(N)'" _n
  7.     }
  8. }

. file close `fh'

